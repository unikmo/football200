{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source":"/api/admin/overview","destination":"/api/admin?route=overview"},
    {"source":"/api/admin/certificate-status","destination":"/api/admin?route=certificate-status"},
    {"source":"/api/admin/certificate-delivery","destination":"/api/admin?route=certificate-delivery"},
    {"source":"/api/admin/child-selection","destination":"/api/admin?route=child-selection"},
    {"source":"/api/admin/email-health","destination":"/api/admin?route=email-health"},
    {"source":"/api/admin/login","destination":"/api/admin?route=login"},
    {"source":"/api/admin/logout","destination":"/api/admin?route=logout"},
    {"source":"/api/admin/schools","destination":"/api/admin?route=schools"},
    {"source":"/api/admin/session","destination":"/api/admin?route=session"},
    {"source":"/api/admin/sponsor-publication","destination":"/api/admin?route=sponsor-publication"},
    {"source":"/api/admin/spotlight","destination":"/api/admin?route=spotlight"},
    {"source":"/api/clubs","destination":"/api/read?route=clubs"},
    {"source":"/api/programme","destination":"/api/read?route=programme"},
    {"source":"/api/schools","destination":"/api/read?route=schools"},
    {"source":"/api/health/firebase","destination":"/api/read?route=health%2Ffirebase"},
    {"source":"/api/health/readiness","destination":"/api/read?route=health%2Freadiness"},
    {"source":"/api/certificates/public","destination":"/api/read?route=certificates%2Fpublic"},
    {"source":"/api/public/club-sponsors","destination":"/api/read?route=public%2Fclub-sponsors"},
    {"source":"/api/public/spotlight","destination":"/api/read?route=public%2Fspotlight"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()"},
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin"},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; font-src 'self' data:; form-action 'self'; upgrade-insecure-requests"}
      ]
    }
  ]
}
